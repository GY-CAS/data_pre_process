# Docker Environment Configuration
# This file is used when running services in Docker containers

# MySQL Configuration
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=infini_rag_flow
MYSQL_DB=test_db

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ClickHouse Configuration
CK_HOST=host.docker.internal
CK_PORT=9006
CK_USER=admin
CK_PASSWORD=admin

# Backend Service URL (for frontend - browser accessible)
# Use localhost since frontend runs in browser, not in container
BACKEND_SERVICE_URL=http://localhost:8005
