FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --legacy-peer-deps

COPY frontend/ ./

ENV BACKEND_SERVICE_URL=http://127.0.0.1:8000

RUN npm run build


COPY docker/frontend_entrypoint.sh ./frontend_entrypoint.sh
RUN chmod +x ./frontend_entrypoint.sh

ENV NODE_ENV=production

EXPOSE 13000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:13000/ || exit 1

ENTRYPOINT ["/app/frontend_entrypoint.sh"]
